      <a:r>
        <a:rPr lang="en-US" sz="1500" dirty="0"/>
        <a:t>Engineered with a responsive glassmorphism user interface using React 19 and Tailwind CSS to ensure compatibility across mobile, tablet, and desktop viewports.</a:t>
      </a:r>
    </a:p>
    <a:p>
