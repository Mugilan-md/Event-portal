    <a:p>
      <a:pPr marL="342900" indent="-342900">
      <a:buFont typeface="+mj-lt"/>
      <a:buAutoNum type="arabicPeriod"/>
    </a:pPr>
      <a:r>
        <a:rPr lang="en-US" sz="1500" dirty="0"/>
        <a:t>To design a secure, modern, and mobile-responsive web portal with intuitive user dashboards and a protected administrative panel.</a:t>
      </a:r>
    </a:p>
    <a:p>
      <a:pPr marL="342900" indent="-342900">
      <a:buFont typeface="+mj-lt"/>
      <a:buAutoNum type="arabicPeriod"/>
    </a:pPr>
      <a:r>
        <a:rPr lang="en-US" sz="1500" dirty="0"/>
        <a:t>To implement atomic NoSQL database transactions that lock seat bookings in real time, preventing concurrent booking overselling.</a:t>
      </a:r>
    </a:p>
    <a:p>
      <a:pPr marL="342900" indent="-342900">
      <a:buFont typeface="+mj-lt"/>
      <a:buAutoNum type="arabicPeriod"/>
    </a:pPr>
      <a:r>
        <a:rPr lang="en-US" sz="1500" dirty="0"/>
        <a:t>To test and evaluate the system&apos;s transaction integrity, page rendering latencies, and QR-code check-in verification throughput under load.</a:t>
      </a:r>
    </a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="3584578261"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>